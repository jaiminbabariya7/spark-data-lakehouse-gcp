# GCP
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# GCS
GCS_LAKEHOUSE_BUCKET=your-lakehouse-bucket

# BigQuery
BQ_GOLD_DATASET=gold

# Dataproc
DATAPROC_REGION=us-central1
DATAPROC_CLUSTER=lakehouse-cluster
DATAPROC_SERVICE_ACCOUNT=lakehouse-sa@your-gcp-project-id.iam.gserviceaccount.com